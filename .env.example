# Web + Telegram. Real .env is never overwritten.
NODE_ENV=development
DATABASE_URL=postgresql://empathy:local_dev_only@127.0.0.1:5432/empathy
TELEGRAM_BOT_TOKEN=
AI_PROVIDER=local
LOCAL_LLM_BASE_URL=
LOCAL_LLM_MODEL=Gemma-3-4B-IT-Q4_K_M
LOCAL_LLM_API_KEY=
AI_TIMEOUT_MS=90000
AI_MAX_CONCURRENCY=1
AI_MAX_QUEUE_LENGTH=8
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
# Three independent 32-byte secrets (64 hex characters each).
EMAIL_CODE_SECRET=
WEB_SESSION_SECRET=
WEB_LINK_SECRET=
WEB_ORIGIN=http://localhost:5173
PORT=3000
# Production compose trusts only the fixed reverse-proxy IP.
TRUSTED_PROXY_IPS=
# VITE_PUBLIC_* presentation only, never secrets.
# Deploy-only: PG_PASSWORD, APP_IMAGE immutable tag/digest, actual HTTPS WEB_ORIGIN.
# Separate test bot and TEST_DATABASE_URL with "test" in DB name are required.
