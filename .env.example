# Telegram-only runtime. Fill locally/hosting; never paste secrets in chat or Git.
NODE_ENV=development
DATABASE_URL=postgresql://empathy:local_dev_only@localhost:5432/empathy
TELEGRAM_BOT_TOKEN=
AI_PROVIDER=local
# /v1 base URL. Production accepts numeric Tailscale 100.64.0.0/10 only.
LOCAL_LLM_BASE_URL=
LOCAL_LLM_MODEL=Qwen3-8B-Q4_K_M
LOCAL_LLM_API_KEY=
AI_TIMEOUT_MS=90000
AI_MAX_CONCURRENCY=1
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
# At least 32 random bytes, hex. Set separately from all bot/model/SMTP secrets.
EMAIL_CODE_SECRET=
