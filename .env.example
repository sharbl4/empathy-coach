# Server only. Fill secrets locally or in hosting; never paste them into chat.
DATABASE_URL=postgresql://empathy:local_dev_only@localhost:5432/empathy
# Optional separate disposable database, name must contain test and differ from DATABASE_URL.
TEST_DATABASE_URL=
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
GIGACHAT_CREDENTIALS=
GIGACHAT_SCOPE=
GIGACHAT_MODEL=
GIGACHAT_BASE_URL=
# For new v1 connections: https://api.giga.chat/v1 (scope/model from your account)
# Optional absolute path to the official CA PEM, local to each machine/container.
NODE_EXTRA_CA_CERTS=
AI_PROVIDER=gigachat
PORT=3000
APP_ORIGIN=http://localhost:5173
NODE_ENV=development
# Public Auth settings only. Restart Vite after changes.
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=
# Optional lead-only live checkpoint. Dedicated confirmed dev/test account.
# One synthetic session and one real model generation; never run against production.
CHECKPOINT_LIVE=0
CHECKPOINT_ORIGIN=http://localhost:3000
CHECKPOINT_EMAIL=
CHECKPOINT_PASSWORD=
